<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the Microsoft Store (MSIX) package. packaging/msix/build_msix.ps1 fills in the @TOKENS@ and writes
  AppxManifest.xml next to Bepo.exe. Identity values come from Partner Center > Product identity.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="@IDENTITY_NAME@"
            Publisher="@PUBLISHER@"
            Version="@VERSION@"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Bepo</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Bepo" Executable="Bepo.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Bepo"
                          Description="Private, on-device voice dictation for Windows."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Launch Bepo when I sign in" (core/startup.py). Off until the user turns it on in Bepo's Settings. -->
        <desktop:Extension Category="windows.startupTask" Executable="Bepo.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="BepoStartup" Enabled="false" DisplayName="Bepo" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Win32 app: global shortcuts, SendInput into other apps, tray icon -->
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
